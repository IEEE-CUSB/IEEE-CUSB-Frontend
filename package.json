    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/axios": "^0.9.36",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^12.29.0",
    "gsap": "^3.14.2",
